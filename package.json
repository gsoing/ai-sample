{
  "name": "dso-ai-sample-project",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:up": "docker compose up -d --wait mongo",
    "db:down": "docker compose down",
    "db:seed": "pnpm --filter api seed",
    "setup:aisdlc": "for s in standards-check standards-impact standards-coherence; do (cd .claude/aisdlc-framework/plugins/governance-impl/skills/$s && npm ci --omit=dev --silent --no-audit --no-fund); done",
    "standards:prepare": "node .claude/aisdlc-framework/plugins/governance-impl/skills/standards-check/scripts/prepare.mjs --diff-base ${DIFF_BASE:-HEAD~1} --out work/standards-check.json",
    "standards:impact": "node .claude/aisdlc-framework/plugins/governance-impl/skills/standards-impact/scripts/prepare.mjs --diff-base ${DIFF_BASE:-HEAD~1} --out work/standards-impact.json",
    "standards:coherence": "node .claude/aisdlc-framework/plugins/governance-impl/skills/standards-coherence/scripts/prepare.mjs --out work/standards-coherence.json",
    "spec:validate": "bash .claude/aisdlc-framework/plugins/spec-driven/skills/spec-validation/run.sh"
  }
}
